{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflowapi.dev/schemas/workflowapi.schema.json",
  "title": "WorkflowAPI Document",
  "type": "object",
  "required": [
    "workflowApi",
    "info"
  ],
  "properties": {
    "workflowApi": {
      "type": "string",
      "pattern": "^0\\.1(\\.\\d+)?$"
    },
    "id": {
      "type": "string",
      "description": "Stable document identifier. Recommended."
    },
    "info": {
      "type": "object",
      "required": [
        "title",
        "version"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "contact": {
          "type": "object",
          "additionalProperties": true
        },
        "license": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string"
        },
        "runtime": {
          "type": "string",
          "description": "Primary workflow runtime identifier, e.g. 'temporal'."
        },
        "environment": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "workflows": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/workflow"
      }
    },
    "activities": {
      "type": "object",
      "description": "Optional top-level activity registry. Activities may be declared here for reuse across workflows and referenced from steps via ref.activity.",
      "additionalProperties": {
        "$ref": "#/$defs/activity"
      }
    },
    "bridges": {
      "type": "object",
      "description": "Cross-boundary durable operation surfaces. Each bridge may expose one or more services with operations. Temporal Nexus is the first concrete bridge binding.",
      "additionalProperties": {
        "$ref": "#/$defs/bridge"
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "schemas": {
          "type": "object",
          "additionalProperties": true
        },
        "examples": {
          "type": "object",
          "additionalProperties": true
        },
        "policies": {
          "type": "object",
          "additionalProperties": true
        },
        "owners": {
          "type": "object",
          "additionalProperties": true
        },
        "tags": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "bindings": {
      "type": "object",
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "workflow": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "internal", "private"]
        },
        "run": {
          "$ref": "#/$defs/operation"
        },
        "signals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          }
        },
        "queries": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          }
        },
        "topology": {
          "$ref": "#/$defs/topology"
        },
        "dependsOn": {
          "type": "object",
          "properties": {
            "workflows": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            },
            "bridges": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            },
            "externalSystems": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            },
            "events": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            }
          },
          "additionalProperties": true
        },
        "bindings": {
          "type": "object",
          "additionalProperties": true
        },
        "searchAttributes": {
          "type": "array",
          "description": "Generic search/filter dimensions. Runtime-specific index types (e.g. Temporal Keyword) belong in bindings.",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "deprecated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "topology": {
      "type": "object",
      "description": "Declared workflow graph. Distinct from observed topology (runtime histories) and operational overlays (metrics). Must be explicitly declared via WorkflowAPI attributes or fluent definitions.",
      "properties": {
        "entry": {
          "type": "string",
          "description": "Optional key of the starting step."
        },
        "steps": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/step"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/schemaRef"
        },
        "output": {
          "$ref": "#/$defs/schemaRef"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "schemaRef": {
      "type": "object",
      "properties": {
        "schema": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": true }
          ]
        },
        "$ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "Step kind. Only primitives that have a natural attributable code artifact are included. activity = activity class, childWorkflow = workflow class invoked as child, bridge = declared bridge operation, custom = escape hatch.",
          "enum": [
            "activity",
            "childWorkflow",
            "bridge",
            "custom"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/stepRef"
        },
        "invocation": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["startAndWait", "startAsync", "fireAndForget", "signalWithStart", "continueAsNew", "custom"]
            },
            "cancellation": {
              "type": "string"
            },
            "result": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "input": {
          "$ref": "#/$defs/schemaRef"
        },
        "output": {
          "$ref": "#/$defs/schemaRef"
        },
        "topology": {
          "$ref": "#/$defs/topology"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "stepRef": {
      "type": "object",
      "description": "Cross-entity reference from a step. Use workflow for childWorkflow steps, bridge+service+operation for bridge steps, activity (optional) for activity steps when key differs.",
      "properties": {
        "workflow": {
          "type": "string",
          "description": "Key of a workflow in this document or a referenced document."
        },
        "document": {
          "type": "string",
          "description": "Optional document id when referencing a workflow in another document."
        },
        "activity": {
          "type": "string",
          "description": "Key of an activity in the top-level activities map. Optional when step key matches activity key."
        },
        "bridge": {
          "type": "string",
          "description": "Key of a bridge in the top-level bridges map."
        },
        "service": {
          "type": "string",
          "description": "Service name within the referenced bridge."
        },
        "operation": {
          "type": "string",
          "description": "Operation name within the referenced bridge service."
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "enum": ["next", "conditional", "parallel", "join", "error", "timeout", "retry", "compensates", "childWorkflow", "bridge", "emits", "consumes", "custom"]
        },
        "label": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "activity": {
      "type": "object",
      "description": "An activity definition in the top-level activity registry.",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "internal", "hidden"]
        },
        "input": {
          "$ref": "#/$defs/schemaRef"
        },
        "output": {
          "$ref": "#/$defs/schemaRef"
        },
        "expectedDuration": {
          "type": "string",
          "description": "ISO 8601 duration."
        },
        "sla": {
          "type": "string",
          "description": "ISO 8601 duration SLA."
        },
        "criticality": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "bindings": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "bridge": {
      "type": "object",
      "description": "A cross-boundary durable operation surface. Temporal Nexus is modelled as a bridge with a temporal binding.",
      "properties": {
        "kind": {
          "type": "string",
          "description": "Bridge kind, e.g. 'durableOperationBridge', 'namespaceBridge', 'engineBridge', 'protocolBridge'."
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "services": {
          "type": "object",
          "description": "Map of service names to bridge service definitions.",
          "additionalProperties": {
            "$ref": "#/$defs/bridgeService"
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "bridgeService": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/bridgeOperation"
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "bridgeOperation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/schemaRef"
        },
        "output": {
          "$ref": "#/$defs/schemaRef"
        },
        "handledBy": {
          "type": "object",
          "properties": {
            "workflow": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "bindings": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}